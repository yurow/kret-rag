# 应用配置
APP_NAME=KRET-RAG LLM Session Manager
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=9000

# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/session_db

# Redis配置
REDIS_URL=redis://localhost:6379/1
SESSION_TTL=3600

# LLM配置 - 新格式（使用JSON配置文件）
LLM_CONFIG_PATH=./config/llm_models.json

# 对话配置
MAX_CONTEXT_LENGTH=10
MAX_TOKEN_LIMIT=4096

# KRET-RAG Scheduler 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# 服务配置
APP_NAME=KRET-RAG Scheduler
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# 数据库配置
# 选项: sqlite, postgresql
DATABASE_TYPE=sqlite

# SQLite 配置（默认）
SQLITE_DATABASE_PATH=./data/documents.db

# PostgreSQL 配置（可选，扩展使用）
# DATABASE_URL=postgresql://user:password@localhost:5432/rag_db

# 向量数据库配置
VECTOR_DB_TYPE=chromadb
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=rag_collection

# Embedding配置
# 推荐：使用本地模型路径（需先运行 download_all_models.py 下载）
EMBEDDING_MODEL=./models/all-MiniLM-L6-v2
# 备选：使用在线模型（自动从 HuggingFace 下载）
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ⚠️ Reranker 模型配置已注释 - 调试基础流程时不需要
# RERANKER_MODEL=./models/bge-reranker-base
# RERANKER_MODEL=BAAI/bge-reranker-base

# HuggingFace 国内镜像（加速模型下载，解决网络超时问题）
# 官方地址: https://huggingface.co
# 国内镜像: https://hf-mirror.com
HF_ENDPOINT=https://hf-mirror.com

# LLM服务配置
LLM_SESSION_URL=http://localhost:9000

# 文档处理配置
MAX_DOCUMENT_SIZE=10485760
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 文件存储配置
UPLOAD_DIR=./uploads

# Redis配置
REDIS_URL=redis://localhost:6379/0

# 调试模式
DEBUG=false
